DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
LOCAL_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
LOCAL_EMBEDDING_PYTHON=python
# 可选：Tavily 外部公开信息搜索。仅由服务端读取，禁止使用 NEXT_PUBLIC_ 前缀。
TAVILY_API_KEY=
# Vercel Serverless OCR：Azure Document Intelligence Read。未配置时扫描件会明确标记 OCR_UNAVAILABLE，不生成假文本。
TENDER_OCR_PROVIDER=azure
TENDER_OCR_ENDPOINT=
TENDER_OCR_API_KEY=
# 可选：语义检索。local 使用已有 Python sentence-transformers；openai-compatible 需要下列地址与密钥。
TENDER_EMBEDDING_PROVIDER=local
TENDER_EMBEDDING_BASE_URL=
TENDER_EMBEDDING_API_KEY=
TENDER_EMBEDDING_MODEL=
# Production：阿里云百炼 OpenAI-compatible Embedding。生产环境须使用 512d 索引，不能与本地 384d 索引混用。
EMBEDDING_PROVIDER=local
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSIONS=512
# 真实企业资料：local 使用 storage/tender-company；vercel-blob 使用私有 Vercel Blob。
# Blob 凭据由 Vercel Project Storage 集成注入，禁止填写真实值到此文件。
STORAGE_PROVIDER=local
